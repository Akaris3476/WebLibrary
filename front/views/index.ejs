<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WebLibrary</title>
    <link rel="stylesheet" href="/static/general.css">
    <link rel="stylesheet" href="/static/index.css">
</head>

<body>

    <header>
        <nav>
            <a href="/login">Login</a>
            <a href="/admin" id="admin" style="display: none;">Admin</a>
        </nav>
        <h1 >
            <img src="/static/book.ico" class="book-icon">WebLibrary
        </h1>

    </header>
    

    <hr style="margin-bottom: 20px; ">


    <div class="book-grid">
        <% books.forEach(book => { %>

            <div class="book-item">

                <h3 style="margin-bottom: 5px;">
                    <%= book.title  %>
                </h3>

                <p>
                    by <%= book.author %> 
                </p>

                <br>

                <p>
                    <!-- add later mb -->
                    *Description* <%= book.description %>  
                </p>

               <button class="btn" onclick="window.location.href=`/read/<%=book.book_id%>`">Read</button>


            </div>


        <% }); %>
    </div>


    <script>

            document.addEventListener('DOMContentLoaded', async ()=>{
                const token = localStorage.getItem('token');

                let res = await fetch('/admin/token-check', {
                    method: 'GET',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                })

                res = await res.json();

                if(res.admin_right){
                    document.getElementById('admin').style.display = 'block';
                };
                
            });

    </script>

</body>
</html>