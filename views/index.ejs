<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WebLibrary</title>
    <link rel="stylesheet" href="/general.css">
    <link rel="stylesheet" href="/index.css">
</head>

<body>

    <header>
        <nav>
            <a href="/login">Login</a>
            <a href="/admin" id="admin" style="display: none;">Admin</a>
        </nav>
        <h1 >
            <img src="book.ico" class="book-icon">WebLibrary
        </h1>

    </header>
    

    <hr style="margin-bottom: 20px; ">


    <div class="book-grid">
        <% books.forEach(book => { %>

            <div class="book-item">

                <button class="delete-button" onclick="deleteBook('<%= book.book_id %>')">x</button>


                <h3 style="margin-bottom: 5px;">
                    <%= book.title  %>
                </h3>

                <p>
                    by <%= book.author %> 
                </p>

                <br>

                <p>
                    <!-- add later mb -->
                    *Description* <%= book.description %>  
                </p>

               <button class="btn" onclick="window.location.href=`/read/<%=book.book_id%>`">Read</button>


            </div>


        <% }); %>
        <div>
            <button class="add-book" onclick="window.location.href='/add'">
                <h1>+</h1>
            </button>
        </div>
    </div>


    <script>

    document.addEventListener('DOMContentLoaded', async ()=>{
        const token = localStorage.getItem('token');

        let res = await fetch('/admin/token-check', {
            method: 'GET',
            headers: {
                'Authorization': `Bearer ${token}`
            }
        })

        res = await res.json()

        if(res.admin_right){
            document.getElementById('admin').style.display = 'block';
        };
                
    });

    async function deleteBook(bookId) {
        if (!confirm("Are you sure you want to delete this book?")) return;

        const token = localStorage.getItem("token");

        try {
            const res = await fetch(`/books/${bookId}`, {
                method: 'DELETE',
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                }
            });

            if (res.ok) {
                location.reload(); // reload the page to reflect deletion
            } else {
                const err = await res.json();
                alert("Delete failed: " + err.message);
            }
        } catch (err) {
            console.error(err);
            alert("An error occurred while deleting the book.");
        }
    }

    </script>

</body>
</html>