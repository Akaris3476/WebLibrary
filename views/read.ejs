<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WebLibrary</title>
    <link rel="stylesheet" href="/general.css">
    <link rel="stylesheet" href="/header.css">
    <link rel="stylesheet" href="/read.css">
</head>

<body>

<header>

    
    <div class="header-title" onclick="window.location.href='/'">
        <img src="/book.ico" class="book-icon">WebLibrary
    </div>

    <% if(typeof error === 'undefined') {%>

        <label id="chapter">
            Chapter:
            <select  class="btn chapter-select">
            </select>
        </label>
        

    <% } %>

</header>

<hr style="margin-top: 0px;">


<main>

    <!-- handle typing wrong id in url -->
    <% if(typeof error !== 'undefined') {%>
        
        <%= error %>
        <br>
        <button class="btn" onclick="window.location.href='/'">Return to home</button>

    <% } else { %>


        <%= content %>


        <!-- not working -->
        <div style="display: flex; justify-content: center;">
            <button class="btn"> < </button>
            <select class="btn"></select>
            <button class="btn"> > </button> 
        </div>

    <% } %>
    
</main>

</body>

</html>